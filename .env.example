# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Google Places (secure backend only - never expose to client)
GOOGLE_PLACES_API_KEY=

# OpenAI (conversation, explanations, ChatGPT app)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Auth providers (Stage 3+)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Data source toggle: "fictional" | "google_places"
BITEJOY_PROVIDER=fictional

# Local HTTP MCP server
PORT=3333

# Where the MCP server is reachable (used by the ChatGPT app / connector config and docs/chatgpt-app.md)
MCP_SERVER_URL=http://localhost:3333/mcp

# Public URL of the supporting website (Stage 4+); the ChatGPT app widget build doesn't need this yet
NEXT_PUBLIC_APP_URL=http://localhost:3000
