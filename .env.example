# --- Supabase (backend / MCP server) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Supabase (apps/web - browser-exposed, so NEXT_PUBLIC_) ---
# Same project as above; mirrored under the Next.js public prefix because
# apps/web's client-side Supabase SSR helper needs these in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase Auth / MCP OAuth resource-server verification ---
# Derived from SUPABASE_URL by convention (issuer = "<SUPABASE_URL>/auth/v1"),
# listed explicitly so the MCP server's token verification doesn't have to
# assume the convention. Confirmed live for this project: JWTs are signed
# with ES256 via Supabase's asymmetric JWT signing keys feature, and the
# JWKS URL below serves real public keys - see docs/mcp-oauth.md.
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=

# --- Google Places (secure backend only - never expose to client) ---
GOOGLE_PLACES_API_KEY=

# --- OpenAI (conversation, explanations, ChatGPT app) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Google / Microsoft OAuth ---
# These are configured directly in the Supabase Dashboard (Authentication >
# Providers), NOT read by application code - Supabase itself performs the
# OAuth exchange. Kept here only as a reference record of what's configured
# there, so a redeploy or a new team member knows what to re-enter.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# --- Data source toggle: "fictional" | "google_places" ---
BITEJOY_PROVIDER=fictional

# --- Local HTTP MCP server ---
PORT=3333

# Where the MCP server is reachable (used by the ChatGPT app / connector config and docs/chatgpt-app.md)
MCP_SERVER_URL=http://localhost:3333/mcp

# Public URL of this MCP server, used as the `resource` value in its OAuth
# Protected Resource Metadata (RFC 9728) - see docs/mcp-oauth.md. In local
# dev this is usually an https tunnel URL (e.g. ngrok), since ChatGPT
# developer mode requires https.
MCP_PUBLIC_URL=http://localhost:3333/mcp

# --- apps/web ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where Supabase should redirect back to after an OAuth/magic-link flow
# completes (apps/web's /auth/callback route). Must be added to the
# Supabase project's allowed redirect URLs.
AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
