{
  "name": "@bitejoy/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/stdio.ts",
    "dev:http": "node --env-file-if-exists=../../.env --import tsx --watch src/http.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start": "node --env-file-if-exists=../../.env dist/stdio.js",
    "start:http": "node --env-file-if-exists=../../.env dist/http.js"
  },
  "dependencies": {
    "@bitejoy/core": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "openai": "^7.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "tsx": "^4.23.4",
    "typescript": "^5.7.2"
  }
}
