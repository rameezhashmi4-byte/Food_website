# apps/web - environment variables
#
# Copy to `.env.local` for local development (gitignored by the repo root
# .gitignore). In production, set these on the hosting platform instead.

# --- Supabase (required) -----------------------------------------------
# The project's URL and ANON (public) key ONLY. Never put the service-role
# key here - this app must never hold or use it, client- or server-side.
# These do not need the NEXT_PUBLIC_ prefix: every Supabase call in this app
# happens in Server Components / Server Actions / Route Handlers, never in
# browser JS, so the values only ever need to be readable on the server.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Site origin (recommended) ------------------------------------------
# Used to build absolute redirect URLs for OAuth and magic-link email
# ("emailRedirectTo" / "redirectTo" must point back at THIS app's
# /auth/callback route, and must also be added to the Supabase project's
# allow-listed Redirect URLs). If unset, the app derives the origin from
# the incoming request's Host header, which is good enough for local dev
# but should be set explicitly in production for reliability behind
# proxies/load balancers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OAuth provider availability (optional) ------------------------------
# Google and Microsoft sign-in both go through Supabase Auth directly (this
# app never sees a Google/Microsoft client secret) - Supabase must have the
# provider configured/enabled in its dashboard for the button to actually
# work. These flags are how THIS deploy declares "yes, that provider is
# wired up in the Supabase project I'm pointed at" - there's no public API
# this app can call to introspect which providers a Supabase project has
# enabled, so we make it an explicit, deploy-time decision instead of
# guessing. Unset/false = the corresponding login button renders disabled
# with a "not configured" label instead of one that would error on click.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=true
NEXT_PUBLIC_MICROSOFT_LOGIN_ENABLED=true
